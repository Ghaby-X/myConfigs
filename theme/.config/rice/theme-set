#!/usr/bin/env bash
# Switches the active rice theme: symlinks each app's current-theme.conf to
# the chosen theme's snippet, then live-reloads what can be live-reloaded.
#
# The current-theme.conf files this writes are intentionally NOT tracked in
# git (see .gitignore) — the active theme is runtime state, fully
# reconstructable by re-running this script. Themes themselves live in
# themes/<name>/ and ARE tracked.
set -euo pipefail

RICE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
THEMES_DIR="$RICE_DIR/themes"

usage() {
  echo "Usage: theme-set <name>"
  echo "Available themes:"
  for d in "$THEMES_DIR"/*/; do
    [[ -f "$d/colors.toml" ]] && echo "  - $(basename "$d")"
  done
}

name="${1:-}"
if [[ -z "$name" ]]; then
  usage
  exit 1
fi

theme_path="$THEMES_DIR/$name"
if [[ ! -f "$theme_path/colors.toml" ]]; then
  echo "No such theme: $name" >&2
  usage
  exit 1
fi

# Every app's theme file is generated from the theme's colors.toml (see
# theme-render); the rendered files live outside the repo and are what the
# app configs link to.
render_path="${XDG_STATE_HOME:-$HOME/.local/state}/rice/rendered/$name"
python3 "$RICE_DIR/theme-render" "$name" "$render_path"

mkdir -p "$HOME/.config/sway" "$HOME/.config/kitty" "$HOME/.config/ags" "$HOME/.config/rofi" "$HOME/.config/swaylock" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" "$HOME/.config/qt6ct/colors" "$HOME/.config/zsh" "$HOME/.config/tmux" "$HOME/.config/nvim/lua/rice"
ln -sfn "$render_path/sway.conf" "$HOME/.config/sway/current-theme.conf"
ln -sfn "$render_path/kitty.conf" "$HOME/.config/kitty/current-theme.conf"
ln -sfn "$render_path/ags.scss" "$HOME/.config/ags/current-theme.scss"
ln -sfn "$render_path/rofi.rasi" "$HOME/.config/rofi/current-theme.rasi"
# zsh: autosuggestion + syntax-highlighting colors, sourced by ~/.zshrc
ln -sfn "$render_path/zsh.zsh" "$HOME/.config/zsh/current-theme.zsh"
# tmux: status bar + pane colors, sourced by ~/.config/tmux/tmux.conf
ln -sfn "$render_path/tmux-theme.conf" "$HOME/.config/tmux/current-theme.conf"
# neovim: palette read by lua/rice (the nvim stow package)
ln -sfn "$render_path/nvim-palette.lua" "$HOME/.config/nvim/lua/rice/palette.lua"
# GTK3/GTK4 pick up ~/.config/gtk-{3,4}.0/gtk.css automatically; whole file
# is theme-managed (named-color overrides), so no include split needed.
ln -sfn "$render_path/gtk.css" "$HOME/.config/gtk-3.0/gtk.css"
ln -sfn "$render_path/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
# Qt (qt6ct, Fusion style + custom palette). qt6ct needs an absolute path to
# the color scheme, so the config is generated here rather than tracked.
# QT_QPA_PLATFORMTHEME=qt6ct comes from the `zsh` stow package (~/.zshenv).
ln -sfn "$render_path/qt6ct.conf" "$HOME/.config/qt6ct/colors/current-theme.conf"
cat > "$HOME/.config/qt6ct/qt6ct.conf" <<QT
[Appearance]
color_scheme_path=$HOME/.config/qt6ct/colors/current-theme.conf
custom_palette=true
icon_theme=Papirus
standard_dialogs=default
style=Fusion
QT
# swaylock has no include directive, so its whole config is theme-managed
# (not a partial "current-theme.*" that gets included by a static file).
ln -sfn "$render_path/swaylock.conf" "$HOME/.config/swaylock/config"
# wallpaper: the theme's default (`default-wallpaper` names a file in backgrounds/,
# which is downloaded rather than committed), else wallpaper.png, else the first
# image in backgrounds/; a wallpaper picked earlier for this theme (see
# wallpaper-set) wins over all of those while its file still exists
wallpaper=""
if [[ -f "$theme_path/default-wallpaper" ]]; then
  candidate="$theme_path/backgrounds/$(tr -d '\n' < "$theme_path/default-wallpaper")"
  [[ -f "$candidate" ]] && wallpaper="$candidate"
fi
[[ -z "$wallpaper" && -f "$theme_path/wallpaper.png" ]] && wallpaper="$theme_path/wallpaper.png"
if [[ -z "$wallpaper" ]]; then
  wallpaper="$(compgen -G "$theme_path/backgrounds/*" | head -n 1 || true)"
fi
saved="${XDG_STATE_HOME:-$HOME/.local/state}/rice/wallpaper/$name"
if [[ -f "$saved" ]] && [[ -f "$(cat "$saved")" ]]; then
  wallpaper="$(cat "$saved")"
fi
[[ -n "$wallpaper" ]] && ln -sfn "$wallpaper" "$RICE_DIR/current-wallpaper"

echo "Theme set to: $name"

if command -v swaymsg >/dev/null && [[ -n "${SWAYSOCK:-}" ]]; then
  swaymsg reload >/dev/null
  echo "sway: reloaded"
fi

# running tmux sessions pick up the new colors immediately
if command -v tmux >/dev/null && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.config/tmux/current-theme.conf" >/dev/null 2>&1 && echo "tmux: reloaded"
fi

# running Neovim instances recolor themselves (each listens on a socket in $XDG_RUNTIME_DIR)
if command -v nvim >/dev/null; then
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*.0; do
    [[ -S "$sock" ]] || continue
    nvim --server "$sock" --remote-send '<Cmd>lua require("rice").reload()<CR>' >/dev/null 2>&1 &
  done
fi

# kitty reloads its config (and so the new colors) in every open window on SIGUSR1
if pkill -USR1 -x kitty 2>/dev/null; then
  echo "kitty: reloaded open windows"
fi

if command -v ags >/dev/null; then
  if ags list 2>/dev/null | grep -q .; then
    ags quit >/dev/null 2>&1 || true
    sleep 0.5
    # `ags quit` doesn't always fully release the app's D-Bus name (seen this
    # hang around as an orphaned gjs process at least once) — if it's still
    # registered, a fresh `ags run` just silently gets routed to it as an
    # unhandled request instead of actually starting. Force it if so.
    if gdbus call --session --dest org.freedesktop.DBus \
         --object-path /org/freedesktop/DBus \
         --method org.freedesktop.DBus.GetConnectionUnixProcessID "io.Astal.ags" \
         >/dev/null 2>&1; then
      pkill -9 -f "gjs -m.*ags\.js" 2>/dev/null || true
      sleep 0.5
    fi
  fi
  setsid ags run >/tmp/ags.log 2>&1 &
  disown
  echo "ags: started/restarted"
fi

if [[ -e "$RICE_DIR/current-wallpaper" ]] && command -v swaybg >/dev/null; then
  pkill -x swaybg 2>/dev/null || true
  setsid swaybg -i "$RICE_DIR/current-wallpaper" -m fill >/tmp/swaybg.log 2>&1 &
  disown
  echo "swaybg: started/restarted"
fi

# System-wide light/dark preference (org.freedesktop.appearance color-scheme,
# read via the xdg-desktop-portal Settings interface) — this is what lets
# portal-aware apps (Firefox, GTK4/libadwaita apps, etc.) follow the rice's
# theme automatically instead of just our own configs.
if [[ -f "$render_path/mode" ]] && command -v gsettings >/dev/null; then
  mode="$(cat "$render_path/mode")"
  case "$mode" in
    dark)  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' ;;
    light) gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' ;;
  esac
  # adw-gtk3 (recolorable via the per-theme gtk.css) has separate light/dark
  # variants; GTK3 apps don't follow color-scheme, so pick the variant here.
  if [[ -d /usr/share/themes/adw-gtk3 ]]; then
    case "$mode" in
      dark)  gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' ;;
      light) gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3' ;;
    esac
  fi
  echo "system color-scheme: $mode"
fi
