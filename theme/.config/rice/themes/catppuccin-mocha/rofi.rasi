/**
 * Catppuccin Mocha — matches this project's other catppuccin-mocha files
 * (not adi1090x's approximate "catppuccin" pack entry, which mixes in
 * different hues).
 **/

* {
    background:     #1E1E2EFF;
    background-alt: #313244FF;
    foreground:     #CDD6F4FF;
    selected:       #89B4FAFF;
    active:         #A6E3A1FF;
    urgent:         #F38BA8FF;
}
