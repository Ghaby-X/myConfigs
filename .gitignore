# Machine-specific overrides — never portable, never committed.
**/config.d/*.conf

# Active-theme symlinks — runtime state managed by theme-set, reconstructable
# by re-running it. The actual theme content lives in theme/.../themes/*/.
**/current-theme.conf
**/current-theme.scss
theme/.config/rice/current-wallpaper

# ags: generated types/build artifacts, npm deps — all regeneratable
# (node_modules/@girs symlink to the system ags install anyway).
ags/.config/ags/node_modules/
ags/.config/ags/@girs/
