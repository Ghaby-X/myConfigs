# Machine-specific overrides — never portable, never committed.
**/config.d/*.conf

# Active-theme symlinks — runtime state managed by theme-set, reconstructable
# by re-running it. The actual theme content lives in theme/.../themes/*/.
**/current-theme.conf
**/current-theme.scss
**/current-theme.css
**/current-theme.rasi
configs/theme/.config/rice/current-wallpaper

# swaylock's whole config is theme-managed (no include directive to split
# out just the color bits), so the active symlink is just "config" here,
# not a "current-theme.*" name like everywhere else.
configs/swaylock/.config/swaylock/config

# ags: generated types/build artifacts, npm deps — all regeneratable
# (node_modules/@girs symlink to the system ags install anyway).
configs/ags/.config/ags/node_modules/
configs/ags/.config/ags/@girs/

# downloaded per-theme wallpapers (see scripts/fetch-wallpapers.sh)
configs/theme/.config/rice/themes/*/backgrounds/
