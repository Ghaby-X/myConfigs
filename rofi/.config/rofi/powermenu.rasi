/**
 * Power menu — custom (not adi1090x-stock), 240px centered popup, single
 * column. Ported from a previously-tuned hyprland+rofi setup.
 **/

configuration {
    show-icons: false;
}

@import "~/.config/rofi/current-theme.rasi"

* {
    font: "JetBrainsMono Nerd Font Bold 13";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            240px;

    padding:          0px;
    border:           0px solid;
    border-radius:    12px;
    border-color:     @selected;
    background-color: @background;
}

mainbox {
    children:         [ "listview" ];
    padding:          15px;
    background-color: transparent;
}

listview {
    columns:          1;
    lines:             5;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    spacing:           5px;
    background-color:  transparent;
}

element {
    padding:           10px;
    border-radius:     8px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            pointer;
}
element selected.normal {
    background-color: @selected;
    text-color:        @background;
}
element-text {
    horizontal-align:  0.5;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        inherit;
}
