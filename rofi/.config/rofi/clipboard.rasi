/** Clipboard history — simple centered list, colors from the active theme. **/

@import "~/.config/rofi/current-theme.rasi"

* {
    font: "JetBrainsMono Nerd Font 10";
}

window {
    location:         center;
    width:            560px;
    border:           0px solid;
    border-radius:    12px;
    background-color: @background;
}

mainbox {
    padding:          14px;
    spacing:          10px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    padding:          8px 12px;
    spacing:          8px;
    border-radius:    8px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt, entry {
    background-color: transparent;
    text-color:       inherit;
}

listview {
    lines:            6;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
    background-color: transparent;
}

element {
    spacing:          12px;
    padding:          8px 12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    size:             56px;
    background-color: transparent;
}
