/**
 * Power menu — custom (not adi1090x-stock), 3x2 icon grid, ported from a
 * previously-tuned hyprland+rofi setup.
 **/

configuration {
    show-icons: true;
}

@import "~/.config/rofi/current-theme.rasi"

* {
    font: "JetBrainsMono Nerd Font Bold 10";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            420px;

    padding:          0px;
    border:           0px solid;
    border-radius:    12px;
    border-color:     @selected;
    background-color: @background;
}

mainbox {
    children:         [ "listview" ];
    padding:          20px;
    background-color: transparent;
}

listview {
    columns:          3;
    lines:             2;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    spacing:           10px;
    background-color:  transparent;
}

element {
    orientation:       vertical;
    padding:           16px 5px;
    border-radius:     8px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            pointer;
}
element selected.normal {
    background-color: @selected;
    text-color:        @background;
}
element-icon {
    size:              40px;
    horizontal-align:  0.5;
    background-color:  transparent;
    cursor:            inherit;
}
element-text {
    font:              "JetBrainsMono Nerd Font 9";
    horizontal-align:  0.5;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        inherit;
}
